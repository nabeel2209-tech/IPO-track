# Copy to backend/.env and fill in what you need.

# SQLite by default. For Postgres (e.g. Neon or Supabase):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/ipo_tracker

# Origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Optional: enables the "Ask AI" page. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5
# ASK_PER_IP_PER_DAY=15
# ASK_GLOBAL_PER_DAY=300
